{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(bun run *)",
      "Bash(bun tsc *)",
      "Bash(bun test *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(gh --version)",
      "Bash(gh workflow *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false
  }
}
