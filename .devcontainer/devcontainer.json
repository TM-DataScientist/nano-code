{
  "name": "nano-code-devcontainer",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/nano-code",
  "remoteUser": "vscode",
  "remoteEnv": {
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },
  "forwardPorts": [1455],
  "portsAttributes": {
    "1455": {
      "label": "Codex OAuth callback",
      "onAutoForward": "silent"
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=/nano-code,type=bind"
  ],
  "postCreateCommand": "if [ ! -f package.json ]; then bun init -y; fi && bun install || true"
}
