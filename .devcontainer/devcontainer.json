{
  "name": "nano-code-devcontainer",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/nano-code",
  "remoteUser": "vscode",
  "forwardPorts": [1455, 43395],
  "portsAttributes": {
    "1455": {
      "label": "Codex OAuth callback",
      "onAutoForward": "silent"
    },
    "43395": {
      "label": "Claude Code OAuth callback",
      "onAutoForward": "silent"
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=/nano-code,type=bind",
    "source=nano-code-codex-auth,target=/home/vscode/.codex,type=volume",
    "source=nano-code-claude-auth,target=/home/vscode/.claude,type=volume",
    "source=nano-code-gh-auth,target=/home/vscode/.config/gh,type=volume"
  ],
  "postCreateCommand": "if [ ! -f package.json ]; then bun init -y; fi && bun install || true"
}
